# ─────────────────────────────────────────────
# Supabase（数据持久化）
# 在 https://supabase.com/dashboard 新建项目后获取
SUPABASE_URL=https://xxxxx.supabase.co
# 使用 service_role key（可绕过 RLS），从 Supabase Dashboard > Project Settings > API 获取
SUPABASE_SERVICE_KEY=eyJhbGc...

# ─────────────────────────────────────────────
# Railway（后端部署 + 前端静态文件）
# Railway Dashboard > 你的服务 > Variables 可批量粘贴
PORT=8080
NODE_ENV=production

# Railway 磁盘挂载路径（存放预编译的前端 dist）
# 在 Railway Dashboard > 你的服务 > Disks 添加 512MB 磁盘后自动填充
RAILWAY_DISK_MOUNT_PATH=/var/data

# 前端打包时注入 API 地址（自动从 Railway 环境变量传递）
# VITE_API_URL 由 Railway 在 build 时注入，无须手动填写
