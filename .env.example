# ============================================================
# 前端环境变量（Vercel / 本地开发都用这套）
# 在 Vercel: Project Settings → Environment Variables
# 在本地: 复制为 client/.env.local
# ============================================================

# Supabase 项目 URL（不是 Edge Function URL，是项目根 URL）
VITE_SUPABASE_URL=https://xxxxx.supabase.co

# anon public key（前端可见，安全）
# 在 Supabase → Settings → API 找 "anon public"
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
