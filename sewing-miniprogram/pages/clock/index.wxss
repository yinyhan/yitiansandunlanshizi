/* pages/clock/index.wxss */
.page { min-height: 100vh; background-color: var(--bg-page); }

/* ========== 月份卡片 ========== */
.month-card { text-align: center; }
.month-nav { display: flex; align-items: center; justify-content: center; gap: var(--space-md); }
.month-arrow {
  width: 64rpx; height: 64rpx;
  border-radius: 50%;
  background-color: var(--bg-page);
  color: var(--text-secondary);
  font-size: 40rpx;
  line-height: 56rpx;
  text-align: center;
  font-weight: 300;
}
.month-arrow:active { background-color: var(--border); }
.month-title {
  font-size: var(--font-xl);
  font-weight: 600;
  color: var(--text-main);
  min-width: 280rpx;
  letter-spacing: var(--ls-wide);
  line-height: var(--lh-tight);
}
.month-summary {
  display: flex; align-items: baseline; justify-content: center;
  gap: var(--space-xs);
  margin-top: var(--space-md);
  color: var(--text-secondary);
  font-size: var(--font-sm);
  line-height: var(--lh-tight);
}
.summary-num { font-size: var(--font-lg); font-weight: 700; color: var(--primary); font-variant-numeric: tabular-nums; }
.summary-unit { font-size: var(--font-sm); }
.summary-divider { color: var(--border); margin: 0 var(--space-xs); }

/* ========== 日历 ========== */
.cal-weekrow {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  margin-bottom: var(--space-md);
}
.cal-weekday {
  text-align: center;
  font-size: var(--font-sm);
  color: var(--text-secondary);
  line-height: var(--lh-tight);
  font-weight: 500;
}

.cal-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: var(--space-xs);
}
.cal-cell {
  position: relative;
  aspect-ratio: 1 / 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-md);
  background-color: var(--bg-page);
  overflow: hidden;
  transition: background-color 0.15s;
}
.cal-cell:active { background-color: var(--border); }
.cal-cell.is-empty { background-color: transparent; }
.cal-cell.is-empty:active { background-color: transparent; }
.cal-cell.is-today { box-shadow: inset 0 0 0 2rpx var(--primary); }
.cal-cell.is-selected {
  background-color: var(--primary);
}
.cal-cell.is-selected .cal-day { color: var(--on-primary); }
.cal-cell.is-future { opacity: 0.4; }
.cal-day {
  font-size: var(--font-sm);
  color: var(--text-main);
  line-height: 1;
  font-variant-numeric: tabular-nums;
}
.cal-mood {
  width: 48rpx; height: 48rpx;
  margin-top: 2rpx;
}
.cal-add {
  font-size: 28rpx;
  color: var(--text-secondary);
  opacity: 0.5;
  margin-top: 4rpx;
  line-height: 1;
  font-weight: 300;
}

/* ========== 详情卡 ========== */
.detail-head {
  display: flex;
  align-items: center;
  gap: var(--space-md);
}
.detail-mood {
  width: 120rpx; height: 120rpx;
  flex-shrink: 0;
}
.detail-info { flex: 1; min-width: 0; }
.detail-date { font-size: var(--font-sm); color: var(--text-secondary); line-height: var(--lh-tight); }
.detail-mood-label {
  font-size: var(--font-xl);
  font-weight: 600;
  margin-top: 4rpx;
  line-height: var(--lh-tight);
}
.detail-edit {
  font-size: var(--font-sm);
  color: var(--primary);
  padding: var(--space-xs) var(--space-sm);
  border: 1rpx solid var(--primary);
  border-radius: var(--radius-sm);
  line-height: 1;
}
.detail-note {
  margin-top: var(--space-md);
  padding: var(--space-md);
  background-color: var(--bg-page);
  border-radius: var(--radius-sm);
  font-size: var(--font-base);
  color: var(--text-main);
  line-height: var(--lh-base);
  font-style: italic;
}
.detail-product {
  margin-top: var(--space-md);
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  font-size: var(--font-sm);
  line-height: 1;
}
.detail-product-tag {
  background-color: var(--primary);
  color: var(--on-primary);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  font-size: 22rpx;
}
.detail-product-name { color: var(--text-main); }
.detail-actions {
  margin-top: var(--space-lg);
  display: flex;
  justify-content: center;
}

.detail-empty {
  text-align: center;
  padding: var(--space-md) 0;
}
.detail-empty-emoji { font-size: 80rpx; line-height: 1; }
.detail-empty-text {
  font-size: var(--font-base);
  color: var(--text-secondary);
  margin-top: var(--space-md);
  line-height: var(--lh-base);
}

/* ========== 心情统计 ========== */
.mood-stats {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: var(--space-sm);
  margin-top: var(--space-sm);
}
.mood-stat {
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-sm) 0;
  border-radius: var(--radius-sm);
  background-color: var(--bg-page);
}
.mood-stat.is-zero { opacity: 0.35; }
.mood-stat-icon { width: 56rpx; height: 56rpx; }
.mood-stat-name {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
  line-height: 1;
}
.mood-stat-count {
  font-size: var(--font-md);
  font-weight: 700;
  margin-top: 2rpx;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

/* ========== 心情弹层 ========== */
.mood-popup-mask {
  position: fixed; inset: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.mood-popup-bg {
  position: absolute; inset: 0;
  background-color: rgba(0, 0, 0, 0.45);
}
.mood-popup {
  position: relative;
  width: 100%;
  background-color: var(--bg-card);
  border-top-left-radius: var(--radius-lg);
  border-top-right-radius: var(--radius-lg);
  padding: var(--space-lg) var(--space-lg) calc(var(--space-lg) + env(safe-area-inset-bottom));
  box-sizing: border-box;
  max-height: 85vh;
  overflow-y: auto;
  /* 提升层级，防止被内部元素覆盖 */
  z-index: 1;
}
.mood-note-wrap { margin-bottom: var(--space-md); }
.mood-popup-title {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text-main);
  text-align: center;
  margin-bottom: var(--space-md);
  line-height: var(--lh-tight);
}
.mood-picker {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: var(--space-sm);
  margin-bottom: var(--space-md);
}
.mood-pick {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-sm) 0;
  border-radius: var(--radius-md);
  border: 2rpx solid transparent;
  transition: all 0.15s;
}
.mood-pick.is-active {
  border-color: var(--primary);
  background-color: var(--bg-page);
  transform: scale(1.05);
}
.mood-pick-icon { width: 72rpx; height: 72rpx; }
.mood-pick-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
  line-height: 1;
}
.mood-pick.is-active .mood-pick-label { color: var(--primary); font-weight: 600; }

.mood-note {
  width: 100%;
  min-height: 120rpx;
  padding: var(--space-md);
  background-color: var(--bg-page);
  border-radius: var(--radius-md);
  font-size: var(--font-base);
  color: var(--text-main);
  line-height: var(--lh-base);
  box-sizing: border-box;
  margin-bottom: var(--space-md);
}
.mood-product-row {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  padding: var(--space-md);
  background-color: var(--bg-page);
  border-radius: var(--radius-md);
  margin-bottom: var(--space-md);
  font-size: var(--font-base);
}
.mood-product-label { color: var(--text-secondary); }
.mood-product-pick {
  flex: 1;
  color: var(--text-main);
  font-size: var(--font-base);
  line-height: var(--lh-tight);
}
.mood-popup-actions {
  display: flex;
  gap: var(--space-md);
  margin-top: var(--space-md);
}
.mood-popup-actions .btn { flex: 1; }
