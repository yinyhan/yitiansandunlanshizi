/* pages/pattern/list.wxss */
.page { min-height: 100vh; background-color: var(--bg-page); }

.search {
  background-color: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-md);
  padding: 0 var(--space-md);
  margin-bottom: var(--space-md);
}
.search-input {
  height: 72rpx;
  font-size: var(--font-base);
  color: var(--text-main);
}

.pattern-card {
  display: flex;
  background-color: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-md);
  padding: var(--space-md);
  margin-bottom: var(--space-md);
  gap: var(--space-md);
}
.pattern-card:active { opacity: 0.7; }

.pattern-cover {
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--radius-md);
  background-color: var(--primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}
.pattern-cover-img {
  width: 100%;
  height: 100%;
  display: block;
}
.pattern-emoji { font-size: 60rpx; line-height: 1; }

.pattern-body { flex: 1; display: flex; flex-direction: column; gap: var(--space-xs); }
.pattern-name {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text-main);
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  flex-wrap: wrap;
  line-height: var(--lh-tight);
}
.pattern-meta { font-size: var(--font-sm); color: var(--text-secondary); line-height: var(--lh-tight); }

.fab {
  position: fixed;
  right: var(--space-lg);
  bottom: calc(var(--tabbar-height) + var(--space-lg));
  width: 112rpx;
  height: 112rpx;
  border-radius: var(--radius-pill);
  background-color: var(--primary);
  color: var(--on-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.15);
  z-index: 9;
}
.fab-icon { font-size: 56rpx; line-height: 1; font-weight: 300; }
.fab:active { transform: scale(0.95); }
