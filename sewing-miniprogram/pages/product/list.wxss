/* pages/product/list.wxss */
.page { min-height: 100vh; background-color: var(--bg-page); }

.search {
  background-color: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-md);
  padding: 0 var(--space-md);
  margin-bottom: var(--space-md);
  display: flex;
  align-items: center;
  height: 72rpx;
}
.search-input { flex: 1; height: 72rpx; font-size: var(--font-base); color: var(--text-main); line-height: var(--lh-tight); }

.stat-row { display: flex; justify-content: space-around; text-align: center; }
.stat-value { font-size: var(--font-2xl); font-weight: 700; color: var(--primary); line-height: var(--lh-numeric); letter-spacing: var(--ls-wide2); }
.stat-label { font-size: var(--font-sm); color: var(--text-secondary); margin-top: var(--space-xs); line-height: var(--lh-tight); }

.item-name { font-size: var(--font-md); font-weight: 600; color: var(--text-main); margin-bottom: var(--space-xs); line-height: var(--lh-tight); }
.item-meta { display: flex; flex-wrap: wrap; gap: var(--space-xs); }
.item-value { font-size: var(--font-md); font-weight: 600; color: var(--primary); line-height: var(--lh-tight); }
.item-sub { font-size: var(--font-sm); color: var(--text-secondary); margin-top: var(--space-xs); line-height: var(--lh-tight); }

.list-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  margin-right: var(--space-md);
  flex-shrink: 0;
  background-color: var(--bg-page);
  display: flex;
  align-items: center;
  justify-content: center;
}
.list-thumb-img {
  width: 100%;
  height: 100%;
  display: block;
}
.list-thumb-empty {
  border: 1rpx dashed var(--border);
  background-color: var(--bg-page);
}
.list-thumb-icon {
  font-size: 56rpx;
  line-height: 1;
  opacity: 0.5;
}

.fab {
  position: fixed; right: var(--space-lg);
  bottom: calc(var(--tabbar-height) + var(--space-lg));
  width: 112rpx; height: 112rpx; border-radius: var(--radius-pill);
  background-color: var(--primary); color: var(--on-primary);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.15); z-index: 9;
}
.fab-icon { font-size: 56rpx; line-height: 1; font-weight: 300; }
.fab:active { transform: scale(0.95); }
